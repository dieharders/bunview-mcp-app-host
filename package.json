{
  "name": "bunview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Bun + WebView scaffold for desktop apps that run on a Claude subscription",
  "scripts": {
    "dev": "bun run build:css && bun run --parallel dev:css dev:app",
    "dev:headless": "bun run build:css && bun run --parallel dev:css dev:app:headless",
    "dev:css": "bunx @tailwindcss/cli -i ./src/client/styles/app.css -o ./src/client/styles/generated.css --watch",
    "dev:app": "bun run --watch=always ./main.ts",
    "dev:app:headless": "bun run --watch=always ./main.ts --headless",
    "build:css": "bunx @tailwindcss/cli -i ./src/client/styles/app.css -o ./src/client/styles/generated.css --minify",
    "build": "bun run build:css && bun run build.ts",
    "build:all": "bun run build:css && bun run build.ts --all",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "bunx prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "webview-bun": "^2.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@tailwindcss/cli": "^4.3.1",
    "@testing-library/react": "^16.1.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.6.3"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
