{
  "name": "bunview-mcp-app-host",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Bun + WebView desktop app scaffold that hosts MCP tools on a Claude Code / Codex subscription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dieharders/bunview-mcp-app-host.git"
  },
  "scripts": {
    "dev": "bun run build:css && bun run --parallel dev:css dev:app",
    "dev:headless": "bun run build:css && bun run --parallel dev:css dev:app:headless",
    "dev:css": "bunx @tailwindcss/cli -i ./src/client/styles/app.css -o ./src/client/styles/generated.css --watch",
    "dev:app": "bun run --watch ./main.ts",
    "dev:app:headless": "bun run --watch ./main.ts --headless",
    "build:css": "bunx @tailwindcss/cli -i ./src/client/styles/app.css -o ./src/client/styles/generated.css --minify",
    "build": "bun run build:css && bun run build.ts",
    "build:all": "bun run build:css && bun run build.ts --all",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test",
    "lint": "bunx eslint .",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "webview-bun": "^2.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@happy-dom/global-registrator": "^15.11.7",
    "@tailwindcss/cli": "^4.3.1",
    "@testing-library/react": "^16.1.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
